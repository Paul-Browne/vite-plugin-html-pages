{
  "name": "vite-plugin-html-pages",
  "version": "2.5.0",
  "author": "Paul Browne",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vite",
    "vite-plugin",
    "vite-plugin-pages",
    "vite-ssg",
    "static-site-generator",
    "ssg",
    "file-based-routing",
    "html-generator",
    "javascript-to-html",
    "static-html",
    "blog-generator",
    "sitelo"
  ],
  "files": [
    "dist/**/*"
  ],
  "description": "Minimal static site generation (SSG) for Vite using JavaScript functions that return HTML",
  "homepage": "https://github.com/paul-browne/vite-plugin-html-pages",
  "repository": {
    "type": "git",
    "url": "https://github.com/paul-browne/vite-plugin-html-pages.git"
  },
  "bugs": {
    "url": "https://github.com/paul-browne/vite-plugin-html-pages/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vite",
    "test:build": "vite build",
    "test:preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
